{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review-page",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "streamlit",
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501"
      ],
      "port": 8501
    },
    {
      "name": "outreach-desk",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "run_ui.py"
      ],
      "port": 8600,
      "env": {
        "OUTREACH_NO_BROWSER": "1"
      }
    }
  ]
}